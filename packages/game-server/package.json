{
  "name": "chaos-creatures-game-server",
  "version": "0.1.0",
  "description": "Chaos Creatures authoritative game server (Railway)",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
