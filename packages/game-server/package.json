  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
