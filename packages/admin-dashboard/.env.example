# Chaos Creatures Admin Dashboard — Environment Variables
# Copy this file to .env.local and fill in actual values.

# Admin Auth (REQ-179: single password, 8hr session)
ADMIN_PASSWORD=your-admin-password
ADMIN_JWT_SECRET=your-jwt-secret-for-session-tokens

# Supabase (service role for full access — bypasses RLS)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Game Server (Railway)
GAME_SERVER_URL=http://localhost:3001
GAME_SERVER_SECRET=your-game-server-secret

# PostHog Analytics (REQ-185)
NEXT_PUBLIC_POSTHOG_API_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: Supabase Dashboard URL for external link
NEXT_PUBLIC_SUPABASE_DASHBOARD_URL=https://app.supabase.com

# Server Port
PORT=3002
